{
    "name": "fiber-interop/scope",
    "description": "Scope: the identity of the operation (request, job) that code belongs to. PHP extension, with a userland polyfill when it is not loaded.",
    "type": "library",
    "license": "MIT",
    "keywords": ["scope", "fiber", "async", "request", "polyfill"],
    "authors": [
        {"name": "Frode Børli", "email": "frode@ennerd.com"}
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "files": ["src/loader.php"]
    },
    "php-ext": {
        "extension-name": "scope",
        "support-zts": true,
        "support-nts": true,
        "configure-options": []
    },
    "archive": {
        "exclude": ["/tests-polyfill", "/.github"]
    },
    "scripts": {
        "test": "phpunit"
    }
}
